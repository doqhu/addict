+// EXP-4: this feedback belongs to the surface commit containing the first usable UI.
+impl Dispatch<wayland_protocols::wp::presentation_time::client::wp_presentation::WpPresentation, ()> for WaylandClientStatePtr {
+    fn event(state: &mut Self, _: &wayland_protocols::wp::presentation_time::client::wp_presentation::WpPresentation,
+        event: wayland_protocols::wp::presentation_time::client::wp_presentation::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let wayland_protocols::wp::presentation_time::client::wp_presentation::Event::ClockId { clk_id } = event {
+            state.get_client().borrow().globals.exp4_clock.store(clk_id as i32, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+impl Dispatch<wayland_protocols::wp::presentation_time::client::wp_presentation_feedback::WpPresentationFeedback, Exp4Feedback> for WaylandClientStatePtr {
+    fn event(_: &mut Self, _: &wayland_protocols::wp::presentation_time::client::wp_presentation_feedback::WpPresentationFeedback,
+        event: wayland_protocols::wp::presentation_time::client::wp_presentation_feedback::Event, data: &Exp4Feedback, _: &Connection, _: &QueueHandle<Self>) {
+        use wayland_protocols::wp::presentation_time::client::wp_presentation_feedback::Event;
+        let time = match event {
+            Event::Presented { tv_sec_hi, tv_sec_lo, tv_nsec, .. } => Some(((u64::from(tv_sec_hi)<<32)|u64::from(tv_sec_lo))*1_000_000_000+u64::from(tv_nsec)),
+            Event::Discarded => None,
+            _ => return,
+        };
+        let clock=data.clock.load(std::sync::atomic::Ordering::Relaxed);
+        if let Some(callback)=data.callback.lock().unwrap().take() { callback(time,(clock>=0).then_some(clock)); }
+    }
+}
